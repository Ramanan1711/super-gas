generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id         String     @id @default(cuid())
  name       String
  phone      String     @unique
  address    String?
  type       String     @default("Commercial") // Commercial, Domestic, Restaurant
  deliveries Delivery[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Delivery {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING") // PENDING, DELIVERED, CANCELLED
  cylinderType   String    @default("19kg Commercial")
  quantity       Int       @default(1)
  emptyCollected Int       @default(0)
  amount         Float     @default(0.0)
  paymentMethod  String    @default("CASH") // CASH, UPI, ONLINE
  paymentStatus  String    @default("PENDING") // PENDING, PAID
  notes          String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}